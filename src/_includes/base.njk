<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}{% if title %} · {% endif %}Quit Nursing</title>
  <meta name="description" content="{{ description or 'Notes on nursing, money, and financial independence.' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192x192.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <header class="site-header">
    <div class="site-header-inner">
    <a href="/" class="site-logo">QUITNURSING.COM</a>
    <nav class="site-nav">
      <a href="/start-here/" {% if page.url == "/start-here/" %}class="active"{% endif %}>Start Here</a>
      <a href="/calculator/" {% if page.url == "/calculator/" %}class="active"{% endif %}>Quit Calculator</a>
      <a href="/recs/" {% if page.url == "/recs/" %}class="active"{% endif %}>Recs</a>
      <a href="/blog/" {% if page.url == "/blog/" or page.url == "/" %}class="active"{% endif %}>All Posts</a>
      <a href="/contact/" {% if page.url == "/contact/" %}class="active"{% endif %}>Contact</a>
   </nav>
    </div>
  </header>

  <main>
    {% if showHero and site.heroImage %}
    <div class="hero-image">
      <img src="{{ site.heroImage }}" alt="{{ site.heroAlt }}">
    </div>
    {% endif %}
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>Quit Nursing. Not financial advice. See <a href="/calculator/#disclaimer">disclaimer</a>.</p>
  </footer>
</body>
</html>
