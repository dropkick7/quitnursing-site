---
layout: base.njk
---
<article class="post">
  {% if image %}
  <div class="post-image">
    <img src="{{ image }}" alt="">
  </div>
  {% endif %}

  <p class="post-eyebrow">
    <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    {% if tags %}{% for tag in tags %}{% if tag != "posts" %} · {{ tag }}{% endif %}{% endfor %}{% endif %}
  </p>

  <h1>{{ title }}</h1>

  <div class="post-body">
    {{ content | safe }}
  </div>
</article>

<hr class="rule">

<section class="comments">
  <h2 class="comments-heading">Notes</h2>
<div id="cusdis_thread"
  data-host="https://cusdis.com"
  data-app-id="baee76fd-cd31-470d-a459-0d8998f15122"
  data-page-id="{{ PAGE_ID }}"
  data-page-url="{{ PAGE_URL }}"
  data-page-title="{{ PAGE_TITLE }}"
></div>
<script async defer src="https://cusdis.com/js/cusdis.es.js"></script>

</section>

<p><a href="/blog/" class="back-link">&larr; All posts</a></p>
