---
layout: base.njk
---
<article class="post">
  {% if image %}
  <div class="post-image">
    <img src="{{ image }}" alt="">
  </div>
  {% endif %}

  <p class="post-eyebrow">
    <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    {% if tags %}{% for tag in tags %}{% if tag != "posts" %} · {{ tag }}{% endif %}{% endfor %}{% endif %}
  </p>

  <h1>{{ title }}</h1>

  <div class="post-body">
    {{ content | safe }}
  </div>
</article>

{% set previousPost = collections.posts | getNextCollectionItem(page) %}
{% set nextPost = collections.posts | getPreviousCollectionItem(page) %}
{% if previousPost or nextPost %}
<nav class="post-nav" aria-label="More posts">
  {% if previousPost %}
  <a href="{{ previousPost.url }}" class="post-nav-prev">
    <span class="post-nav-label">&larr; Previous post</span>
    <span class="post-nav-title">{{ previousPost.data.title }}</span>
  </a>
  {% endif %}
  {% if nextPost %}
  <a href="{{ nextPost.url }}" class="post-nav-next">
    <span class="post-nav-label">Next post &rarr;</span>
    <span class="post-nav-title">{{ nextPost.data.title }}</span>
  </a>
  {% endif %}
</nav>
{% endif %}

<hr class="rule">

<section class="comments">
  <h2 class="comments-heading">Notes</h2>
<div
  id="echothread"
  data-shortname="quit-nursing"
  data-api-key="_4zP9fJcpflCwfd5GDEYEZkgfJKc2P2NPhEM2vqBWKY"
  data-identifier="{{ page.url }}"
  data-page-url="https://quitnursing.com{{ page.url }}"
  data-accent-color="#4A7C93"
></div>
<script src="https://cdn.echothread.io/widget.js" async></script>

</section>

<p><a href="/blog/" class="back-link">&larr; All posts</a></p>
