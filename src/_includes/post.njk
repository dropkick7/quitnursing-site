---
layout: base.njk
---
<article class="post">
  {% if image %}
  <div class="post-image">
    <img src="{{ image }}" alt="">
  </div>
  {% endif %}

  <p class="post-eyebrow">
    <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    {% if tags %}{% for tag in tags %}{% if tag != "posts" %} · {{ tag }}{% endif %}{% endfor %}{% endif %}
  </p>

  <h1>{{ title }}</h1>

  <div class="post-body">
    {{ content | safe }}
  </div>
</article>

<hr class="rule">

<section class="comments">
  <h2 class="comments-heading">Notes</h2>
<script src="https://giscus.app/client.js"
        data-repo="dropkick7/quitnursing-site"
        data-repo-id="R_kgDOT43cCg"
        data-category="Announcements"
        data-category-id="DIC_kwDOT43cCs4DEWSy"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="en"
        crossorigin="anonymous"
        async>
</script>
</section>

<p><a href="/blog/" class="back-link">&larr; All posts</a></p>
