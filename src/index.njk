---
layout: base.njk
title: Quit Nursing
description: Notes on nursing, money, and financial independence.
showHero: true
---
<div class="page-columns">
  <div class="main-column">
    <div class="article-list">
      {% for post in collections.posts %}
      <a class="article-row" href="{{ post.url }}">
        <span class="article-thumb">
          {% if post.data.image %}<img src="{{ post.data.image }}" alt="">{% endif %}
        </span>
        <span class="article-body">
          <span class="article-date">{{ post.date | readableDate }}</span>
          <span class="article-title">{{ post.data.title }}</span>
          <span class="article-excerpt">{{ post.data.excerpt or (post.templateContent | excerpt(140)) }}</span>
        </span>
      </a>
      {% else %}
      <p>First post is coming soon.</p>
      {% endfor %}
    </div>
    <p class="list-footer">more writing soon</p>
  </div>

  <aside class="sidebar">
    <div class="sidebar-box">
      <span class="sidebar-label">About</span>
      <p class="sidebar-text">A nurse in her 40s, later to FIRE than most, figuring out the math for a work optional life.</p>
      <a href="/start-here/" class="sidebar-link">more about me &rarr;</a>
    </div>
    <div class="sidebar-box sidebar-stats" id="countdown" data-quit-date="{{ site.quitDate }}" data-shifts-per-week="{{ site.shiftsPerWeek }}">
      <span class="sidebar-label">Years to go</span>
      <span class="stat-number" id="countdown-years">{{ site.yearsToGo }}</span>
      <div class="stat-divider"></div>
      <span class="sidebar-label">Shifts to work</span>
      <span class="stat-number" id="countdown-shifts">{{ site.shiftsToWork }}</span>
    </div>
  </aside>
</div>

{% raw %}
<script>
(function () {
  var box = document.getElementById("countdown");
  if (!box) return;
  var end = new Date(box.getAttribute("data-quit-date") + "T00:00:00");
  var perWeek = Number(box.getAttribute("data-shifts-per-week"));
  var ms = end - new Date();
  if (isNaN(ms)) return;
  var years = Math.max(0, Math.round(ms / (365.25 * 864e5)));
  var shifts = Math.max(0, Math.round(ms / (7 * 864e5) * perWeek));
  document.getElementById("countdown-years").textContent = years;
  document.getElementById("countdown-shifts").textContent = shifts.toLocaleString("en-US");
})();
</script>
{% endraw %}